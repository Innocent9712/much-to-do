# --- Application ---
PORT=8080
ENVIRONMENT=production

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://app.muchtodo.com,https://staging.muchtodo.com"

# --- Cookies ---
# Comma-separated list of allowed cookie domains
COOKIE_DOMAINS="localhost,example.com,.muchtodo.com"
SECURE_COOKIE=true


# --- Database ---
# Production/Staging: Use MongoDB Atlas connection string
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/muchtodo?retryWrites=true&w=majority
# Local Development: Use local MongoDB
MONGO_URI=
DB_NAME=much_todo_db

# --- Authentication ---
JWT_SECRET_KEY="your-super-secret-key-that-is-long-and-random-CHANGE-IN-PRODUCTION"
JWT_EXPIRATION_HOURS=72

# --- Caching ---
# Production/Staging: Use ElastiCache Redis endpoint
# ENABLE_CACHE=true
# REDIS_ADDR=your-elasticache-endpoint.cache.amazonaws.com:6379
# REDIS_PASSWORD=
# Local Development:
# Set to "true" to enable Redis caching, "false" to disable.
# ENABLE_CACHE=true
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# --- Logging ---
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL="INFO"
# Log format: "json" or "text"
LOG_FORMAT="json"

# --- AWS Configuration (for production/staging) ---
# AWS_REGION=us-east-1
# CLOUDWATCH_LOG_GROUP=/aws/ec2/muchtodo-api
# CLOUDWATCH_LOG_STREAM=production

# --- Rate Limiting ---
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW=15m

# --- Testing ---
INTEGRATION=true

# ==================================================
# LOCAL DEVELOPMENT ONLY - Docker Compose Configuration
# ==================================================
MONGO_INITDB_ROOT_PASSWORD="Password!234"
MONGO_INITDB_ROOT_USERNAME=muchtodousr
MONGO_INITDB_DATABASE=much_todo_db
# MONGO_HOST=host.docker.internal
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# UI Tools
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin123
